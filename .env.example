# Supabase — Project Settings → API in the Supabase dashboard.
# The URL and publishable/anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — NEVER prefix with NEXT_PUBLIC, never exposed to the browser.
# Used by server routes/jobs that must bypass RLS (imports, hold release).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Stripe — Phase 2 (leave unset until we wire payments).
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
