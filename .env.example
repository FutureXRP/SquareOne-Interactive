# Every variable below goes in Vercel → Project → Settings → Environment
# Variables, then redeploy. The admin "Go live" tab checks each of these
# against the real service and tells you what's still missing.

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — NEVER prefix with NEXT_PUBLIC. Used by the Stripe webhook,
# outgoing email, and password resets, which must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ───────────────────────────────────────────────────
# Developers → API keys. sk_test_ charges nobody; sk_live_ charges real cards.
STRIPE_SECRET_KEY=sk_live_...

# Developers → Webhooks → add endpoint https://YOUR-DOMAIN/api/billing/webhook
# Send these five events, then copy the endpoint's signing secret here:
#   checkout.session.completed      — membership signups AND booking payments
#   customer.subscription.updated   — plan changes, cancellations taking effect
#   customer.subscription.deleted   — membership actually ended
#   invoice.paid                    — monthly renewals into the payments ledger
#   invoice.payment_failed          — the card bounced, so we can email them
# Without this secret, money moves at Stripe but nothing is recorded here.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Where the site lives ─────────────────────────────────────
# The address customers actually type. Stripe sends people back here after
# paying and every email link points at it, so a stale value breaks both.
NEXT_PUBLIC_SITE_URL=https://squareoneinteractive.com

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_...
# REQUIRED for real customers. Left unset, the app falls back to Resend's
# shared onboarding@resend.dev sender, which only ever delivers to your own
# inbox — every customer confirmation would silently go nowhere. Use an
# address on a domain showing Verified in Resend.
RESEND_FROM=SquareOne Interactive <hello@squareoneinteractive.com>

# ── Scheduled reminders ──────────────────────────────────────
# Any long random string. Vercel Cron sends it automatically on the hourly
# call to /api/reminders/run; without it, tour and event reminders only go
# out when someone presses the button on the Calendar tab.
CRON_SECRET=any-long-random-string

# ── Member door unlock (optional) ────────────────────────────
# The deployed SquareOne-Dashboard backend, and a shared secret set to the
# SAME value in both apps.
# DASHBOARD_URL=https://your-dashboard.vercel.app
# DOOR_SERVICE_TOKEN=<same long random string as the Dashboard>
