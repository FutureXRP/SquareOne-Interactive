# Supabase — Project Settings → API in the Supabase dashboard.
# The URL and publishable/anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — NEVER prefix with NEXT_PUBLIC, never exposed to the browser.
# Used by server routes/jobs that must bypass RLS (imports, hold release).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Stripe — recurring fitness-membership billing.
# Secret key: Stripe dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret: Developers → Webhooks → add endpoint
# https://YOUR-DOMAIN/api/billing/webhook with events
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted — then copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Your deployed URL — used for Stripe redirects and email links.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Member door unlock — connects to the SquareOne Dashboard's door system.
# DASHBOARD_URL is the deployed SquareOne-Dashboard backend; DOOR_SERVICE_TOKEN
# is a long random string set to the SAME value in both apps.
# DASHBOARD_URL=https://your-dashboard.vercel.app
# DOOR_SERVICE_TOKEN=<same long random string as the Dashboard>

# Email (optional) — membership confirmation emails via Resend.
# Without it, Supabase confirms signups and Stripe emails payment receipts.
# RESEND_API_KEY=re_...
# RESEND_FROM=SquareOne Interactive <hello@yourdomain.org>
